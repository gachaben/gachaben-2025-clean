{
  "compilerOptions": {
    "noEmit": true,
    "strict": false,
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": ["node", "react", "react-dom"],
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@/firebase": ["fbkit/index.ts"],
      "@/fbkit/*": ["fbkit/*"]         // ← 追加（あると便利）
    }
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "legacy_deprecated"]
}
