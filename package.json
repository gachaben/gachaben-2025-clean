{
  "name": "gachaben-2025-clean",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "dev:emu": "concurrently \"firebase emulators:start --project demo-gachaben\" \"npm run dev\"",
    "seed:problems": "node scripts/seedProblems.js",
    "seed:mistakes": "node scripts/seedMistakes.js",
    "newnote": "pwsh -NoProfile -Command \"$d = Get-Date -Format 'yyyy-MM-dd'; node scripts/newNote.js; git add notes; git commit -m '📝 作業メモ自動生成 $d'; git log --oneline -n 3; git tag\"",
    "finish": "pwsh -NoProfile -Command \"$d = Get-Date -Format 'yyyy-MM-dd'; git add .; git commit -m '✅ 作業完了 $d'; git tag end-$d; git push origin main --tags; git log --oneline -n 3; git tag\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.2",
    "fast-glob": "^3.3.3",
    "firebase-tools": "^14.14.0",
    "kill-port": "^2.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.0.4",
    "wait-on": "^8.0.4"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.5.0",
    "framer-motion": "^12.23.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.1"
  }
}
