rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function userDoc(uid) {
      return get(/databases/$(db)/documents/users/$(uid));
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && userDoc(request.auth.uid).data.role == 'admin';
    }
    function isBanned() {
      return isSignedIn() && userDoc(request.auth.uid).data.role == 'banned';
    }

    // ----- users コレクション -----
    match /users/{uid} {

      // 読み取り: 自分 or admin。banned も自分の user doc だけは読める
      allow get, list: if isSelf(uid) || isAdmin();

      // 作成: 自分の doc だけ作成可（サインアップ直後: ensureUserDoc を想定）
      allow create: if isSelf(uid) && !isBanned();

      // 更新: 
      //  - 自分: プロフィール系の限定フィールドのみ
      //  - admin: 何でも可（role 変更を含む）
      allow update: if
        (!isBanned()) && (
          isAdmin() ||
          (isSelf(uid) &&
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly([
                'displayName',
                'displayNameLower',
                'lastLoginAt',
                'email' // 任意（不要なら外す）
              ])
          )
        );

      // 削除: admin のみ
      allow delete: if isAdmin();
    }

    // ----- battles コレクション -----
    match /battles/{id} {
      // 読み取り: admin は全件、自分は自分のものだけ
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // 作成: サインイン済み && userId が自分
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // 更新: admin のみ
      allow update: if isAdmin();

      // 削除: admin のみ
      allow delete: if isAdmin();
    }

    // ----- mistakes コレクション -----
    match /mistakes/{id} {
      // 読み取り: admin は全件、自分は自分のものだけ
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // 作成: サインイン済み && userId が自分
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // 更新: 自分 or admin
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // 削除: admin のみ
      allow delete: if isAdmin();
    }

    // それ以外は閉じる
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
