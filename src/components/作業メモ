⏭ 明日やること

useEffect で購読処理追加

useEffect(() => {
  const q = query(
    collection(db, "mistakes"),
    where("uid", "==", currentUser.uid),
    orderBy("createdAt", "desc")
  );
  const unsub = onSnapshot(q, (snapshot) => {
    setMistakes(snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() })));
  });
  return () => unsub();
}, [currentUser.uid]);


